# OpenAI-compatible LLM configuration for PA Compass.
# The app works without a key in deterministic baseline mode; add an
# OpenAI API key to enable AI-assisted evidence extraction and
# follow-up question drafting.

# 1. Your OpenAI API key (required for AI-assisted mode)
OPENAI_API_KEY=

# 2. Optional: model override (defaults to gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# 3. Optional: point at any OpenAI-compatible endpoint instead of OpenAI
#    (e.g. a self-hosted gateway). Leave blank to use OpenAI directly.
LLM_BASE_URL=

# 4. Optional: alternate key slot, if you prefer LLM_API_KEY over
#    OPENAI_API_KEY. Either one works.
LLM_API_KEY=
