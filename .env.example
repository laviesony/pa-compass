# LLM provider: "openai" (default) or "deepseek"
LLM_PROVIDER=openai
# Model id — e.g. gpt-4o-mini, gpt-4o, deepseek-chat, deepseek-v4-flash
LLM_MODEL=gpt-4o-mini
# Set your key here, or export OPENAI_API_KEY / DEEPSEEK_API_KEY instead
LLM_API_KEY=
# Optional override, e.g. https://api.deepseek.com/v1 for DeepSeek
LLM_BASE_URL=
LOG_LEVEL=info
